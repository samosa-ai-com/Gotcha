# Environment template for Project Falcon.
# Copy to .env and fill in real values. Never commit secrets.
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# LLM provider keys (kept out of git)
LLM_API_KEY=
LLM_MODEL=falcon-3b
LLM_TEMPERATURE=0.3

# Storage
DB_PATH=./falcon.db
CACHE_DIR=./cache
MAX_ATTACHMENT_BYTES=20971520
MAX_EXTRACTED_CHARS=40000

# Feature flags
ENABLE_DOCUMENT_ATTACHMENTS=true
ENABLE_LEGACY_DOC=false
