<?xml version="1.0" encoding="utf-8"?>
<!--
    Night-mode twin of values-v31/themes.xml. The window still follows the
    night ground, but the splash keeps the video's own light shade: the
    footage is light either way, and a dark splash behind a light logo and
    a light video would flash twice.
-->
<resources>
    <style name="Theme.Gotcha" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
