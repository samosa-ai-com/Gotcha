<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- All Gotcha-managed files live under /storage/emulated/0/Gotcha. -->
    <external-path name="gotcha" path="Gotcha/" />
    <!-- Lens-mode cropped images shared for "Copy Image" (content:// clip). -->
    <cache-path name="lens" path="lens/" />
    <!-- "Share your Gotcha moment" poster PNGs. -->
    <cache-path name="poster" path="poster/" />
    <!-- APK updates downloaded by in-app updater. -->
    <cache-path name="updates" path="updates/" />
</paths>
