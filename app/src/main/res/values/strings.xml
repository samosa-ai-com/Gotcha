    <string name="language_page_intro">Every language Gotcha uses, in one place: what the app\'s own screens are written in, what Gotcha speaks and hears, and what it writes its answers in.</string>
    <string name="language_display_title">App display language</string>
    <string name="language_display_description">Gotcha\'s own buttons, labels and settings are in English only for now — changing this affects the rest of your phone, not this app.</string>
    <string name="language_display_open_settings">Open Android language settings</string>
    <string name="language_display_settings_failed">Could not open language settings.</string>
    <string name="language_voice_title">Voice language</string>
    <string name="language_voice_description">What Gotcha speaks aloud and listens for during voice input and calls. Leave it following the reply language unless you want answers written in one language and spoken in another.</string>
    <string name="language_voice_follow_reply">Same as AI reply language</string>
    <string name="language_voice_speech_hint">Which model and voice read it out are picked under Settings → AI → Speech.</string>
    <string name="language_transcription_title">Transcription language</string>
    <string name="language_transcription_description">The language Gotcha writes your speech down in, for voice input, calls and transcribing audio files.</string>
    <string name="language_transcription_hint_api">Leave this empty and speech is transcribed in the voice language. Set it to force one language, which helps accuracy when the model tends to guess wrong.</string>
    <string name="language_transcription_hint_android">Only Samosa AI and external speech-to-text use this. Android Built-in always transcribes in the voice language.</string>
    <string name="language_transcription_hint_off">Only Samosa AI and external speech-to-text use this. Speech-to-text is off.</string>
